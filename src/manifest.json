{
  "manifest_version": 3,
  "name": "书签导航台",
  "version": "1.13.2",
  "description": "书签导航台：DrMush 制作的书签导航新标签页，支持搜索、分类、整理与待办。",
  "minimum_chrome_version": "116",
  "permissions": [
    "bookmarks",
    "history",
    "storage"
  ],
  "host_permissions": [
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*"
  ],
  "optional_permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
